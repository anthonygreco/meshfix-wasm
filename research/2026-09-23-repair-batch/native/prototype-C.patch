+// PROTOTYPE: minimum-weight triangulation of a boundary loop (Barequet-Sharir style DP).
+// Weight = triangle area + small chord-length term; near-zero-area triangles and chords that
+// already exist as interior edges get a large penalty so the DP routes around them.
+static std::vector<std::array<int,3>> minWeightTriangulation(const pmp::SurfaceMesh& mesh, const std::vector<pmp::Vertex>& lv) {
+    const int n = (int)lv.size();
+    std::vector<pmp::Point> P(n); for (int i = 0; i < n; ++i) P[i] = mesh.position(lv[i]);
+    double diam = 0, eSum = 0;
+    for (int i = 0; i < n; ++i) { eSum += pmp::distance(P[i], P[(i+1)%n]); for (int j = i+1; j < n; ++j) diam = std::max(diam, (double)pmp::distance(P[i], P[j])); }
+    const double eMean = eSum / n, degenArea = 1e-6 * diam * diam, BIG = 1e12;
+    auto chordBad = [&](int i, int j) {
+        if (j == i + 1 || (i == 0 && j == n - 1)) return false; // loop edge
+        auto h = mesh.find_halfedge(lv[i], lv[j]);
+        if (!h.is_valid()) return false;
+        return !(mesh.is_boundary(h) || mesh.is_boundary(mesh.opposite_halfedge(h)));
+    };
+    std::vector<std::vector<double>> W(n, std::vector<double>(n, 0.0));
+    std::vector<std::vector<int>> K(n, std::vector<int>(n, -1));
+    for (int len = 2; len < n; ++len) for (int i = 0; i + len < n; ++i) {
+        int j = i + len; double best = BIG * 1e3; int bk = -1;
+        for (int k = i + 1; k < j; ++k) {
+            const double area = 0.5 * pmp::norm(pmp::cross(P[k] - P[i], P[j] - P[i]));
+            double w = W[i][k] + W[k][j] + area + 0.05 * eMean * ((double)pmp::distance(P[i], P[j]));
+            if (area < degenArea) w += BIG;
+            if (chordBad(i, k) || chordBad(k, j) || chordBad(i, j)) w += BIG;
+            if (w < best) { best = w; bk = k; }
+        }
+        W[i][j] = best; K[i][j] = bk;
+    }
+    std::vector<std::array<int,3>> out;
+    std::vector<std::pair<int,int>> st{{0, n - 1}};
+    while (!st.empty()) { auto [i, j] = st.back(); st.pop_back(); if (j - i < 2) continue; int k = K[i][j]; out.push_back({i, k, j}); st.push_back({i, k}); st.push_back({k, j}); }
+    return out;
+}
