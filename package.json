{
  "name": "meshfix-wasm",
  "version": "0.5.0",
  "description": "Client-side 3D mesh repair library using WASM",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "install-emsdk": "bash scripts/install-emsdk.sh",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:ts": "tsc",
    "build": "npm run build:wasm && npm run build:ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "serve": "npx http-server . -p 8080 -c-1",
    "preversion": "npm run build && npm test",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "mesh",
    "3d-printing",
    "stl",
    "obj",
    "repair",
    "geometry",
    "pmp"
  ],
  "author": "Anthony Greco <anthony.greco@gmail.com> (https://justfixstl.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthonygreco/meshfix-wasm.git"
  },
  "homepage": "https://github.com/anthonygreco/meshfix-wasm",
  "bugs": {
    "url": "https://github.com/anthonygreco/meshfix-wasm/issues"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "http-server": "^14.1.1",
    "vitest": "^4.1.8"
  }
}
